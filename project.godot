; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DancingLineCaffeineRush"
run/main_scene="uid://de0xiiyxx4sn5"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[debug]

shapes/collision/shape_color=Color(0, 0.6, 0.69803923, 1)
shapes/collision/contact_color=Color(1, 0.2, 0.101960786, 1)

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg", "res://addons/spaces_uploads/plugin.cfg")

[global_group]

Floor="Line allowed on floor, dies when hits walls"
LineHead=""
ActionBlock="Does something when the line hits it"

